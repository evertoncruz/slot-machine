# .gitattributes (criar na raiz do projeto)

# ============================================
# Auto detect text files and normalize line endings to LF
# ============================================
* text=auto

# ============================================
# Arquivos de Código (sempre LF)
# ============================================
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# ============================================
# Arquivos de Configuração (sempre LF)
# ============================================
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.env text eol=lf
.env.example text eol=lf
tsconfig.json text eol=lf
package.json text eol=lf
package-lock.json text eol=lf

# ============================================
# Arquivos Binários (sem conversão)
# ============================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.zip binary
*.gz binary
*.tar binary